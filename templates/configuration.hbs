<div class="qb-shell qb-config-shell">
  <form class="qb-configuration-form">
    <section class="qb-section">
      <div class="qb-section-heading">
        <h2>Participating Player Actors</h2>
        <label class="qb-add-player">
          <span>Add a player</span>
          <select data-app-action="add-player" aria-label="Add a player character mapping">
            <option value="">Select a player</option>
            {{#each availableUsers}}<option value="{{id}}">{{name}}</option>{{/each}}
          </select>
        </label>
      </div>
      <div class="qb-config-rows" data-config-collection="players">
        {{#each config.players}}
          <fieldset data-config-row class="qb-player-row">
            <label class="qb-field">
              <select data-field="userId">
                {{#each users}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
              </select>
            </label>
            <label class="qb-field qb-actor-field">
              <span>Player actor</span>
              <select data-field="actorUuid" data-actor-selector size="{{actorListSize}}" required>
                <option value="">Select an actor</option>
                {{#each actors}}<option value="{{uuid}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
              </select>
            </label>
            <button type="button" class="qb-secondary" data-app-action="remove-row" aria-label="Remove player character mapping">Remove</button>
          </fieldset>
        {{/each}}
      </div>
    </section>

    <section class="qb-section">
      <div class="qb-section-heading">
        <h2>Encounter groups</h2>
        <button type="button" class="qb-secondary" data-app-action="add-group">Add group</button>
      </div>
      <div class="qb-config-rows" data-config-collection="encounterGroups">
        {{#each config.encounterGroups}}
          <fieldset data-config-row class="qb-group-row">
            <input data-field="id" type="hidden" value="{{id}}" />
            <label class="qb-field"><span>Group name</span><input type="text" data-field="name" value="{{name}}" required /></label>
            <button type="button" class="qb-secondary" data-app-action="remove-group" aria-label="Remove encounter group {{name}}">Remove group</button>
          </fieldset>
        {{/each}}
      </div>
    </section>

    <section class="qb-section">
      <div class="qb-section-heading">
        <h2>Encounters</h2>
        <button type="button" class="qb-secondary" data-app-action="add-encounter">Add encounter</button>
      </div>
      <div class="qb-config-rows" data-config-collection="encounters">
        {{#each config.encounters}}
          <fieldset data-config-row data-encounter-id="{{id}}" class="qb-encounter-config-row">
            <input data-field="id" type="hidden" value="{{id}}" />
            <label class="qb-field"><span>Encounter name</span><input type="text" data-field="name" value="{{name}}" required /></label>
            <div class="qb-field qb-group-field">
              <span>Encounter groups</span>
              <details class="qb-group-picker">
                <summary data-group-summary>{{selectedGroupSummary}}</summary>
                <div class="qb-config-checks">
                  {{#each groupOptions}}
                    <label><input data-field="groups" type="checkbox" value="{{id}}" {{#if selected}}checked{{/if}} /> <span data-group-name>{{name}}</span></label>
                  {{else}}
                    <span class="qb-muted">Add an encounter group first.</span>
                  {{/each}}
                </div>
              </details>
            </div>
            <div class="qb-config-actions">
              <button type="button" class="qb-secondary" data-app-action="edit-encounter" aria-label="Configure encounter {{name}}">Configure</button>
              <button type="button" class="qb-secondary" data-app-action="remove-row" aria-label="Remove encounter {{name}}">Remove</button>
            </div>
          </fieldset>
        {{/each}}
      </div>
    </section>

    <section class="qb-section">
      <h2>Encounter difficulty bands</h2>
      <p class="qb-muted">Ranges must cover d20 results 1–20 contiguously, without gaps or overlaps.</p>
      <div class="qb-config-rows" data-config-collection="encounterDifficultyBands">
        {{#each config.encounterDifficultyBands}}
          <fieldset data-config-row class="qb-difficulty-row">
            <label class="qb-field"><span>Minimum roll</span><input type="text" data-field="min" type="number" min="1" max="20" value="{{min}}" required /></label>
            <label class="qb-field"><span>Maximum roll</span><input type="text" data-field="max" type="number" min="1" max="20" value="{{max}}" required /></label>
            <label class="qb-field"><span>Label</span><input type="text" data-field="label" value="{{label}}" required /></label>
            <label class="qb-field"><span>Encounter DC</span><input type="text" data-field="dc" type="number" value="{{dc}}" required /></label>
            <label class="qb-checkbox-field"><input type="text" data-field="combat" type="checkbox" {{#if isCombat}}checked{{/if}} /> Combat band</label>
            <button type="button" class="qb-secondary" data-app-action="remove-row">Remove band</button>
          </fieldset>
        {{/each}}
      </div>
      <button type="button" class="qb-secondary" data-app-action="add-band">Add difficulty band</button>
    </section>

    <section class="qb-section">
      <h2>Fate and travel</h2>
      <label class="qb-field"><span>Easy Fate DC</span><input data-field="fateDcEasy" type="number" value="{{config.fateDcs.easy}}" required /></label>
      <label class="qb-field"><span>Medium Fate DC</span><input data-field="fateDcMedium" type="number" value="{{config.fateDcs.medium}}" required /></label>
      <label class="qb-field"><span>Hard Fate DC</span><input data-field="fateDcHard" type="number" value="{{config.fateDcs.hard}}" required /></label>
      <label class="qb-field"><span>Camp bonus</span><input data-field="campBonus" type="number" value="{{config.campBonus}}" required /></label>
      <label class="qb-field"><span>Fast pace modifier</span><input data-field="paceFast" type="number" value="{{config.paceModifiers.fast}}" required /></label>
      <label class="qb-field"><span>Regular pace modifier</span><input data-field="paceNormal" type="number" value="{{config.paceModifiers.normal}}" required /></label>
      <label class="qb-field"><span>Slow pace modifier</span><input data-field="paceSlow" type="number" value="{{config.paceModifiers.slow}}" required /></label>
    </section>

    <section class="qb-section">
      <h2>Spell slot bonuses</h2>
      {{#each config.spellSlots}}
        <label class="qb-field"><span>Level {{level}} slot</span><input data-field="spellSlot{{level}}" type="number" value="{{bonus}}" required /></label>
      {{/each}}
    </section>

    <section class="qb-section">
      <h2>Results and damage</h2>
      <label class="qb-field"><span>Maximum damage fraction (0–1)</span><input data-field="damageCap" type="number" min="0" max="1" step="0.05" value="{{config.damageCap}}" required /></label>
      <label class="qb-checkbox-field"><input data-field="postGmResults" type="checkbox" {{#if config.postGmResults}}checked{{/if}} /> Post GM results to chat</label>
    </section>

    <section class="qb-section">
      <div class="qb-section-heading">
        <h2>Feature catalog changes</h2>
        <button type="button" class="qb-secondary" data-app-action="add-override">Add feature change</button>
      </div>
      <p class="qb-muted">Add custom features, change a feature's type or bonus, or disable a catalog entry by name.</p>
      <div class="qb-config-rows" data-config-collection="catalogOverrides">
        {{#each config.catalogOverrides}}
          <fieldset data-config-row data-config-index="{{@index}}" class="qb-feature-row">
            <label class="qb-field"><span>Feature name</span><input type="text" data-field="name" value="{{name}}" required /></label>
            <label class="qb-field"><span>Description override</span><textarea data-field="description" rows="2">{{description}}</textarea></label>
            <label class="qb-field">
              <span>Type</span>
              <select data-field="type">
                <option value="Passive" {{#if isPassive}}selected{{/if}}>Passive</option>
                <option value="Active" {{#if isActive}}selected{{/if}}>Active</option>
              </select>
            </label>
            <label class="qb-field">
              <span>Rating</span>
              <select data-field="rating">
                <option value="Low" {{#if isLow}}selected{{/if}}>Low (+1)</option>
                <option value="Medium" {{#if isMedium}}selected{{/if}}>Medium (+2)</option>
                <option value="High" {{#if isHigh}}selected{{/if}}>High (+3)</option>
              </select>
            </label>
            <label class="qb-field"><span>Passive bonus override</span><input data-field="bonus" type="number" value="{{bonus}}" /></label>
            <label class="qb-field"><span>Bonus per active use override</span><input data-field="bonusPerUse" type="number" value="{{bonusPerUse}}" /></label>
            <label class="qb-checkbox-field"><input data-field="disabled" type="checkbox" {{#if disabled}}checked{{/if}} /> Disable this catalog entry</label>
            <button type="button" class="qb-secondary" data-app-action="remove-row">Remove feature change</button>
          </fieldset>
        {{/each}}
      </div>
    </section>

    <button type="button" class="qb-primary qb-config-save" data-app-action="save-config">Validate and save settings</button>
  </form>

  <dialog class="qb-config-dialog" data-encounter-dialog aria-labelledby="qb-encounter-dialog-title">
    <div class="qb-dialog-content">
      <div class="qb-section-heading">
        <h2 id="qb-encounter-dialog-title" data-dialog-title>Configure encounter</h2>
        <button type="button" class="qb-secondary" data-app-action="cancel-encounter-dialog" aria-label="Close encounter configuration">Close</button>
      </div>
      <label class="qb-field qb-dialog-wide"><span>Description</span><textarea data-dialog-field="description" rows="3"></textarea></label>
      <label class="qb-field"><span>Difficulty label override</span><input data-dialog-field="difficultyLabel" placeholder="Use the Fate difficulty" /></label>
      <label class="qb-field"><span>DC override</span><input data-dialog-field="dc" type="number" placeholder="Use the Fate difficulty" /></label>
      <section class="qb-config-subsection qb-dialog-wide">
        <h3>Enemy roster</h3>
        <p class="qb-muted">Optional GM guidance; roster counts do not modify encounter difficulty.</p>
        <div class="qb-config-rows" data-dialog-roster></div>
        <button type="button" class="qb-secondary" data-app-action="add-dialog-roster">Add enemy</button>
      </section>
      <div class="qb-dialog-actions qb-dialog-wide">
        <button type="button" class="qb-secondary" data-app-action="cancel-encounter-dialog">Cancel</button>
        <button type="button" class="qb-primary" data-app-action="save-encounter-dialog">Save encounter details</button>
      </div>
    </div>
  </dialog>

  <dialog class="qb-confirm-dialog" data-group-confirm-dialog aria-labelledby="qb-group-confirm-title">
    <form method="dialog">
      <h2 id="qb-group-confirm-title">Remove encounter group?</h2>
      <p data-confirm-message></p>
      <div class="qb-dialog-actions">
        <button type="submit" value="cancel" class="qb-secondary">Cancel</button>
        <button type="submit" value="confirm" class="qb-primary">Remove group</button>
      </div>
    </form>
  </dialog>
</div>
