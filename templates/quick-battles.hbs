<section class="qb-shell {{#if isParticipant}}qb-participant-shell{{/if}}">
  {{#if isParticipant}}
    <form class="qb-check-form">
      <header class="qb-actor-header">
        <img src="{{actor.img}}" alt="" />
        <div>
          <h2>{{actor.name}}</h2>
          <p>{{actor.classLine}} · HP {{actor.hp}} · AC {{actor.ac}}</p>
        </div>
      </header>

      <div class="qb-check-totals">
        <div class="qb-active-bonus-preview qb-passive-bonus-preview" data-passive-bonus="{{passive.total}}">
          <span>Total passive</span><strong>{{signed passive.total}}</strong>
        </div>
        <div class="qb-active-bonus-preview" data-active-bonus-preview data-max-active-uses="{{maxActiveUses}}" role="status" aria-live="polite" aria-atomic="true">
          <span>Total active <small data-active-use-feedback></small></span>
          <strong data-bonus-total>+0</strong>
        </div>
        <div class="qb-active-bonus-preview qb-combined-bonus-preview" role="status" aria-live="polite">
          <span>Total bonus</span><strong data-combined-bonus>{{signed passive.total}}</strong>
        </div>
      </div>
      <div class="qb-check-scroll">
      <div class="qb-panel">
        <h3>Passive bonuses</h3>
        <dl class="qb-bonus-list">
          <div><dt>Highest ability ({{passive.abilityName}})</dt><dd>{{signed passive.ability}}</dd></div>
          <div><dt>Armor class</dt><dd>{{signed passive.armor}}</dd></div>
          {{#each passiveEntries}}
            <div><dt>{{name}}</dt><dd>{{signed bonus}}</dd></div>
          {{/each}}
        </dl>
      </div>

      <label class="qb-field">
        <span>Situational modifier</span>
        <input name="situational" type="number" value="{{situational}}" min="-30" max="30" />
      </label>

      <div class="qb-panel">
        <h3>Active features</h3>
        {{#if activeItems.length}}
          <div class="qb-resource-list">
            {{#each activeItems}}
              <div class="qb-resource-row">
                <span>{{name}} <small>+{{bonusPerUse}} each · {{#if resourceCostPerUse}}{{available}} ({{resourceAvailable}}/{{resourceCostPerUse}}){{else}}{{available}}{{/if}} available</small></span>
                <div class="qb-resource-stepper">
                  <button type="button" data-resource-step="-1" aria-label="Decrease {{name}} uses">−</button>
                  <input name="active-{{itemId}}" type="number" min="0" max="{{available}}" value="0" data-bonus-count data-bonus-per-use="{{bonusPerUse}}" aria-label="{{name}} uses" />
                  <button type="button" data-resource-step="1" aria-label="Increase {{name}} uses">+</button>
                </div>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="qb-muted">No catalogued active feature uses are available.</p>
        {{/if}}
      </div>

      <div class="qb-panel">
        <h3>Spell slots</h3>
        {{#if spellSlots.length}}
          <div class="qb-resource-list">
            {{#each spellSlots}}
              <label class="qb-resource-row">
                <span>Level {{level}} <small>+{{bonus}} each · {{available}} available</small></span>
                <input name="slot-{{level}}" type="number" min="0" max="{{available}}" value="0" data-bonus-count data-bonus-per-use="{{bonus}}" {{#unless available}}disabled{{/unless}} />
              </label>
            {{/each}}
          </div>
        {{else}}
          <p class="qb-muted">No spell-slot capacity on this actor.</p>
        {{/if}}
        <details class="qb-spells">
          <summary>Known spells ({{spells.length}})</summary>
          {{#each spells}}
            <div>Level {{level}} · {{name}}</div>
          {{else}}
            <div class="qb-muted">No spells on this actor.</div>
          {{/each}}
        </details>
      </div>
      </div>
      <button class="qb-primary qb-check-submit" type="button" data-app-action="submit-check">Roll vs DC {{dc}}</button>
    </form>
  {{else}}
    <div class="qb-main-layout {{#unless showCurrentRun}}qb-main-layout-no-opposition{{/unless}}">
      <div class="qb-primary-column">
        {{#if showCurrentRun}}
          <section class="qb-section qb-current-run {{#if state.fateResult.failed}}qb-threat-run{{/if}}">
            <header class="qb-section-heading">
              <div>
                <h2>Quick Battle</h2>
                <span class="qb-eyebrow">Current run</span>
              </div>
              {{#if checksComplete}}
                <span class="qb-stage-badge">Complete</span>
              {{else if noThreat}}
                <span class="qb-stage-badge">No threat</span>
              {{else if state.fateResult.failed}}
                <span class="qb-stage-badge qb-stage-threat">Threat detected</span>
              {{else}}
                <span class="qb-stage-badge">In progress</span>
              {{/if}}
            </header>
            <p class="qb-muted">{{state.statusLabel}}</p>
            {{#if state.fateResult}}
              <div class="qb-result qb-fate-result">
                <strong>{{state.fateResult.label}}</strong>
                <span>{{state.fateResult.total}} vs DC {{state.fate.dc}}</span>
                <span>Base roll {{state.fateResult.baseRoll}} · pace {{signed state.fateResult.paceModifier}} · situation {{signed state.fateResult.situational}} · camp {{signed state.fateResult.campModifier}}</span>
                {{#if state.fateResult.failed}}
                  <span>{{state.fateResult.difficulty.label}} · DC {{state.fateResult.difficulty.dc}}</span>
                  {{#if state.fateResult.showWatchShift}}
                    {{#if state.fateResult.watchShift}}<span>Watch shift {{state.fateResult.watchShift}}</span>{{/if}}
                  {{/if}}
                {{/if}}
              </div>
            {{/if}}
            {{#if state.rolls.length}}
              <div class="qb-roll-list">
                <h3>Checks</h3>
                <div class="qb-rolls">
                  {{#each state.rolls}}
                    <div><span>{{label}}</span><strong>{{#if pending}}Pending{{else}}{{total}}{{/if}}</strong></div>
                  {{/each}}
                </div>
              </div>
            {{/if}}
            {{#if canCancelRun}}
              <button class="qb-secondary qb-cancel-run" type="button" data-app-action="cancel-run">Cancel current run</button>
            {{/if}}
            {{#if noThreat}}
              <button class="qb-primary" type="button" data-app-action="new-battle">New Quick Battle</button>
            {{/if}}
          </section>
        {{else}}
          <section class="qb-section qb-fate-section">
            <header class="qb-section-heading">
              <div>
                <span class="qb-eyebrow">Start a Quick Battle</span>
                <h2>Fate Check</h2>
              </div>
              {{!-- <span class="qb-stage-badge">New run</span> --}}
            </header>
            <p class="qb-muted">A single d20 determines whether a threat finds the party. Apply pace, camp, and situational modifiers below.</p>
            <form class="qb-fate-form">
              <label class="qb-field">
                <span>Situation</span>
                <select name="situation">
                  <option value="travel">Traveling</option>
                  <option value="camp">Camping</option>
                </select>
              </label>
              <label class="qb-field">
                <span>Area difficulty</span>
                <select name="area">
                  {{#each fateAreas}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} · DC {{dc}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="qb-field">
                <span>Travel pace</span>
                <select name="pace">
                  <option value="fast">Fast · {{signed config.paceModifiers.fast}}</option>
                  <option value="normal" selected>Regular · {{signed config.paceModifiers.normal}}</option>
                  <option value="slow">Slow · {{signed config.paceModifiers.slow}}</option>
                  <option value="stealth">Stealth group check</option>
                </select>
              </label>
              <label class="qb-field">
                <span>Situational modifier</span>
                <input name="situational" type="number" value="0" min="-30" max="30" />
              </label>
              <button class="qb-primary" type="button" data-app-action="start-fate">Start Fate check</button>
            </form>
          </section>
        {{/if}}
      {{#if showEncounter}}
        {{#if groups.length}}
          <section class="qb-section qb-encounter-section">
            <header class="qb-section-heading">
              <div>
                <h2>Encounter</h2>
                <span class="qb-eyebrow">Select</span>
              </div>
              <span class="qb-stage-badge">01</span>
            </header>
            <label class="qb-field">
              <span>Encounter group / area</span>
              <select name="encounter-group" {{#if checksComplete}}disabled{{/if}}>
                {{#each groups}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
              </select>
            </label>
            <button class="qb-secondary" type="button" data-app-action="choose-encounter" {{#unless canChooseEncounter}}disabled{{/unless}}>Choose random encounter</button>
            {{#if state.selectedEncounter}}
              <div class="qb-encounter-card">
                <span class="qb-eyebrow">{{state.selectedEncounter.difficultyLabel}} · DC {{state.selectedEncounter.dc}}</span>
                <strong>{{state.selectedEncounter.name}}</strong>
                <p>{{state.selectedEncounter.description}}</p>
                <details class="qb-gm-only">
                  <summary>GM roster guidance</summary>
                  {{#each state.selectedEncounter.roster}}
                    <div>{{name}} × {{count}}</div>
                  {{else}}
                    <div>No roster configured.</div>
                  {{/each}}
                </details>
              </div>

            {{/if}}
          </section>
        {{else}}
          <section class="qb-section qb-encounter-section">
            <header class="qb-section-heading">
              <div>
                <span class="qb-eyebrow">Encounter setup</span>
                <h2>Encounter data required</h2>
              </div>
            </header>
            <p class="qb-muted">Add encounter groups and entries in Game Settings → Module Settings → Quick Battles configuration.</p>
          </section>
        {{/if}}
      {{/if}}
      </div>
      {{#if state.selectedEncounter}}
      <aside class="qb-secondary-column">
        {{#if checksComplete}}<h2 class="qb-combat-complete">Combat complete</h2>{{/if}}
        <section class="qb-section qb-participant-section">
          <header class="qb-section-heading">
            <div><h2>Party</h2><span class="qb-eyebrow">Battle Participants</span></div>
            <span class="qb-stage-badge">{{actors.length}} configured</span>
          </header>
          <div class="qb-participants">
            {{#each actors}}
              {{#if ../checksStarted}}
                {{#if checkStatus}}
                  <article class="qb-party-card">
                    <img src="{{img}}" alt="" />
                    <div><strong>{{name}} (Level {{level}})</strong><span>HP {{hp}}/{{maxHp}} · AC {{ac}}</span><span class="qb-party-status qb-party-status-{{status}}">{{checkStatus}}</span>{{#if damageApplied}}<small>Damage applied</small>{{/if}}</div>
                    <div class="qb-party-card-action">{{#if canApplyDamage}}<button type="button" class="qb-secondary qb-damage-button" data-app-action="apply-party-damage" data-actor-uuid="{{uuid}}" aria-label="Apply {{damage}} damage to {{name}}">Apply damage</button>{{/if}}</div>
                  </article>
                {{/if}}
              {{else}}
                <label class="qb-participant-row">
                  <span class="qb-participant-name"><input type="checkbox" class="qb-participant" value="{{uuid}}" {{#if defaultSelected}}checked{{/if}} /> {{name}}</span>
                  <input class="qb-situational" data-actor-uuid="{{uuid}}" type="number" value="0" aria-label="Situational modifier for {{name}}" />
                </label>
              {{/if}}
            {{/each}}
          </div>
          {{#if checksComplete}}
            <button class="qb-primary" type="button" data-app-action="new-battle">New Quick Battle</button>
          {{else}}
            {{#unless checksStarted}}<button class="qb-primary" type="button" data-app-action="start-checks" {{#unless canStartChecks}}disabled{{/unless}}>Start Participant Checks</button>{{/unless}}
          {{/if}}
        </section>
      </aside>
      {{/if}}
    </div>
    <dialog class="qb-confirm-dialog" data-reset-confirm-dialog aria-labelledby="qb-reset-title">
      <form method="dialog">
        <h2 id="qb-reset-title">Start a new Quick Battle?</h2>
        <p>Some damage has not been applied. Starting a new battle will discard those pending damage actions.</p>
        <div class="qb-dialog-actions"><button type="submit" value="cancel" class="qb-secondary">Cancel</button><button type="submit" value="confirm" class="qb-primary">Start new battle</button></div>
      </form>
    </dialog>
  {{/if}}
</section>
